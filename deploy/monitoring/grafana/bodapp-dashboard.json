{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Grafana Cloud hosted metrics (the default Prometheus datasource of your stack)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Bodapp — Production (Hetzner VPS → Grafana Cloud)",
  "uid": "bodapp-prod",
  "description": "Host, containers, PostgreSQL, Caddy HTTP and external availability for the Bodapp stack. All series carry environment=production, service=bodapp (vmagent external_labels). cAdvisor has no restart counter: restarts are derived with changes(container_start_time_seconds[1h]). SQL text is never exported: statements are identified by numeric queryid only.",
  "tags": ["bodapp", "production", "hetzner"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "Host", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },

    { "id": 2, "type": "stat", "title": "CPU utilization", "description": "1 − idle CPU, averaged over all cores, 5m rate", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "{{instance}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 3, "type": "stat", "title": "Memory available", "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1073741824 }, { "color": "green", "value": 2147483648 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 4, "type": "stat", "title": "Root disk free", "description": "All mounted filesystems except tmpfs/overlay; threshold 15% matches the disk alert", "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 15 }, { "color": "green", "value": 30 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * min(node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"})", "legendFormat": "min free", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 5, "type": "stat", "title": "Load (1m)", "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 4 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "node_load1", "legendFormat": "load1", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 6, "type": "timeseries", "title": "CPU utilization (%)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "busy", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 7, "type": "timeseries", "title": "Load average", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_load1", "legendFormat": "load1", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "node_load5", "legendFormat": "load5", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "C", "expr": "node_load15", "legendFormat": "load15", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 8, "type": "timeseries", "title": "Memory & swap", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "node_memory_MemAvailable_bytes", "legendFormat": "available", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes - node_memory_Buffers - node_memory_Cached", "legendFormat": "used", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "C", "expr": "node_memory_SwapFree_bytes", "legendFormat": "swap free", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 9, "type": "timeseries", "title": "Disk free (%) by mount", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}", "legendFormat": "{{mountpoint}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 10, "type": "timeseries", "title": "Disk I/O", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(node_disk_read_bytes_total[5m])", "legendFormat": "{{device}} read", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "rate(node_disk_written_bytes_total[5m])", "legendFormat": "{{device}} write", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 11, "type": "timeseries", "title": "Network throughput", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (device) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m]))", "legendFormat": "{{device}} rx", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "sum by (device) (rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m]))", "legendFormat": "{{device}} tx", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 12, "type": "row", "title": "Containers", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "collapsed": false },

    { "id": 13, "type": "timeseries", "title": "CPU per container (cores)", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 14, "type": "timeseries", "title": "Memory working set per container", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name!=\"\"})", "legendFormat": "{{name}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 15, "type": "timeseries", "title": "Container restarts (last hour)", "description": "cAdvisor exposes no restart counter; a container recreation changes container_start_time_seconds, so changes() counts restarts (supported community pattern).", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "changes(container_start_time_seconds{name!=\"\"}[1h])", "legendFormat": "{{name}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 16, "type": "timeseries", "title": "CPU throttling ratio", "description": "CPU starvation is invisible in raw usage: throttled periods / total periods while at quota.", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (name) (rate(container_cpu_cfs_throttled_periods_total{name!=\"\"}[5m])) / sum by (name) (rate(container_cpu_cfs_periods_total{name!=\"\"}[5m]))", "legendFormat": "{{name}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 17, "type": "timeseries", "title": "OOM kills (1h)", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (name) (increase(container_oom_events_total{name!=\"\"}[1h]))", "legendFormat": "{{name}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 18, "type": "timeseries", "title": "Container network", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (name) (rate(container_network_receive_bytes_total{name!=\"\"}[5m]))", "legendFormat": "{{name}} rx", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "sum by (name) (rate(container_network_transmit_bytes_total{name!=\"\"}[5m]))", "legendFormat": "{{name}} tx", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 19, "type": "row", "title": "PostgreSQL", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 }, "collapsed": false },

    { "id": 20, "type": "stat", "title": "Database availability (pg_up)", "gridPos": { "h": 5, "w": 4, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "pg_up", "legendFormat": "pg_up", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 21, "type": "gauge", "title": "Connection utilization", "description": "Active+idle backends vs max_connections (alert threshold 80%)", "gridPos": { "h": 5, "w": 5, "x": 4, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * sum(pg_stat_activity_count) / pg_settings_max_connections", "legendFormat": "used", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 22, "type": "stat", "title": "Database size", "gridPos": { "h": 5, "w": 5, "x": 9, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(pg_database_size_bytes{datname!~\"template.*\"})", "legendFormat": "size", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 23, "type": "stat", "title": "Cache hit ratio", "gridPos": { "h": 5, "w": 5, "x": 14, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 95 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))", "legendFormat": "hit %", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 24, "type": "stat", "title": "Tracked statements", "description": "Rows in pg_stat_statements (bounded to max=100 by setup-postgres-monitoring.sh)", "gridPos": { "h": 5, "w": 5, "x": 19, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(pg_stat_statements_calls_total) or vector(0)", "legendFormat": "queryids", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 25, "type": "timeseries", "title": "Connections by state", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (state) (pg_stat_activity_count)", "legendFormat": "{{state}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 26, "type": "timeseries", "title": "Transactions per second", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[5m]))", "legendFormat": "{{datname}} commits", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname!~\"template.*\"}[5m]))", "legendFormat": "{{datname}} rollbacks", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 27, "type": "timeseries", "title": "Locks by mode & longest transaction", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 54 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (mode) (pg_locks_count)", "legendFormat": "locks {{mode}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "max(pg_stat_activity_max_tx_duration)", "legendFormat": "oldest tx (s)", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "hide": false }
      ] },

    { "id": 28, "type": "timeseries", "title": "Slowest statements — total time (queryid only, no SQL)", "description": "topk by accumulated execution seconds over 1h; identify queryids with pg_stat_statements locally if needed.", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "topk(8, sum by (queryid) (rate(pg_stat_statements_seconds_total[1h])))", "legendFormat": "queryid {{queryid}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 29, "type": "timeseries", "title": "Statement calls & mean time", "description": "Call rate (left) and mean execution time per call (right axis logic: seconds/call).", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "topk(8, sum by (queryid) (rate(pg_stat_statements_calls_total[1h])))", "legendFormat": "calls {{queryid}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "topk(8, sum by (queryid) (rate(pg_stat_statements_seconds_total[1h])) / sum by (queryid) (rate(pg_stat_statements_calls_total[1h])))", "legendFormat": "mean s {{queryid}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 30, "type": "timeseries", "title": "Deadlocks & cache block I/O", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 62 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (datname) (increase(pg_stat_database_deadlocks[1h]))", "legendFormat": "deadlocks {{datname}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_blks_read[5m]))", "legendFormat": "disk reads/s", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "C", "expr": "sum(rate(pg_stat_database_blks_hit[5m]))", "legendFormat": "cache hits/s", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 31, "type": "row", "title": "HTTP (Caddy)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 70 }, "collapsed": false },

    { "id": 32, "type": "timeseries", "title": "Request rate", "gridPos": { "h": 8, "w": 8, "x": 0, "y": 71 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(caddy_http_request_duration_seconds_count[5m]))", "legendFormat": "requests/s", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 33, "type": "timeseries", "title": "Response codes", "description": "Status code lives on caddy_http_request_duration_seconds*, not on caddy_http_requests_total.", "gridPos": { "h": 8, "w": 8, "x": 8, "y": 71 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (code) (rate(caddy_http_request_duration_seconds_count[5m]))", "legendFormat": "{{code}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 34, "type": "timeseries", "title": "5xx error rate (%)", "gridPos": { "h": 8, "w": 8, "x": 16, "y": 71 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[5m])) / sum(rate(caddy_http_request_duration_seconds_count[5m]))", "legendFormat": "5xx %", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 35, "type": "timeseries", "title": "Latency percentiles", "description": "histogram_quantile over caddy_http_request_duration_seconds_bucket.", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 79 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(caddy_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 36, "type": "timeseries", "title": "Requests in flight / upstream health", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 79 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(caddy_http_requests_in_flight)", "legendFormat": "in flight", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } },
        { "refId": "B", "expr": "up", "legendFormat": "scrape {{job}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } }
      ] },

    { "id": 37, "type": "row", "title": "Availability & scrape health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 87 }, "collapsed": false },

    { "id": 38, "type": "stat", "title": "External /healthz status", "description": "Grafana Cloud Synthetic Monitoring HTTP check on https://<domain>/healthz (create it once in the portal — see README). Until the check exists this panel is empty, not broken.", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 88 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "none", "mappings": [ { "type": "value", "options": { "200": { "text": "OK (200)", "color": "green" }, "0": { "text": "FAILED", "color": "red" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 200 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "probe_http_status_code", "legendFormat": "status", "instant": true, "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 39, "type": "timeseries", "title": "External check latency", "gridPos": { "h": 6, "w": 6, "x": 6, "y": 88 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "probe_duration_seconds", "legendFormat": "probe", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 40, "type": "timeseries", "title": "Sample freshness (seconds since last scrape per job)", "description": "Grows when a target or vmagent stops delivering; pairs with the 'stale data' alert.", "gridPos": { "h": 6, "w": 6, "x": 12, "y": 88 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 180 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "max by (job) (time() - timestamp(up))", "legendFormat": "{{job}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] },

    { "id": 41, "type": "timeseries", "title": "Scrape health per job (up)", "gridPos": { "h": 6, "w": 6, "x": 18, "y": 88 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "min by (job) (up)", "legendFormat": "{{job}}", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" } } ] }
  ]
}
