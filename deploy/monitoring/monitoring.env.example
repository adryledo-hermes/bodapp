# ---------------------------------------------------------------------------
# Bodapp monitoring — TEMPLATE for the server-side root-owned env file
# (written by setup-monitoring.sh to /opt/bodapp-monitoring/.env, mode 0600,
# owner root — this copy in git contains PLACEHOLDERS only).
#
# Where the real values come from (Grafana Cloud portal, no guessing):
#   1. grafana.com → Sign in → your stack
#   2. Stack → Details → "Prometheus" / Hosted metrics service card
#   3. On that service's details page:
#        URL    = the remote-write endpoint (…/api/prom/push)  → GF_PROM_URL
#        User   = numeric instance id                          → GF_PROM_USER
#        Token  = "send data" section → "Generate now" (needs Admin role,
#                 scope metrics:write) — shown ONCE              → GF_PROM_PASSWORD
#
# Never commit real values; never `cat` this file in CI — every script
# validates with `docker compose config --quiet` instead of printing.
# ---------------------------------------------------------------------------
GF_PROM_URL=https://prometheus-prod-00.grafana.net/api/prom/push
GF_PROM_USER=000000
GF_PROM_PASSWORD=replace-with-write-token

# Generated on the server by setup-monitoring.sh (hex = URL-safe), consumed by
# postgres_exporter's DSN and by setup-postgres-monitoring.sh to CREATE/ALTER
# the dedicated read-only role. Not a Grafana value — listed here so the whole
# file documents every secret the stack holds.
PG_MON_USER=bodapp_monitor
PG_MON_PASSWORD=
PG_MON_DB=bodapp
