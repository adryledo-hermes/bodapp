# ---------------------------------------------------------------------------
# Bodapp — INFRASTRUCTURE pipeline secrets (.github/workflows/infra.yml)
#
# This is a CATALOG of GitHub environment secrets, not a file the server or
# docker-compose ever loads. Copy the values into:
#   GitHub → Settings → Environments → prod → Environment secrets
# Never commit real values.
#
# The business-logic pipeline (deploy.yml) has its own secret set — see
# deploy/github-actions-deploy.md. DEPLOY_* are shared by both workflows
# (same VPS); CADDY_DOMAIN is read by both (infra renders it into the
# Caddyfile, deploy.yml only derives PUBLIC_BASE_URL from it).
# ---------------------------------------------------------------------------

# --- Required: SSH access to the Hetzner VPS (shared with deploy.yml) -------
DEPLOY_HOST="116.203.12.34"
DEPLOY_USER="deploy"
# Private key content (full PEM text of e.g. ~/.ssh/bodapp_deploy); its
# public half must be in DEPLOY_USER's authorized_keys on the VPS.
DEPLOY_SSH_KEY=""

# --- Required: HTTPS / Caddy (consumed only by the infrastructure pipeline) --
# Public hostname — rendered into the site address of the Caddyfile template
# (deploy/caddy/Caddyfile → /etc/caddy/Caddyfile) and used by the end-to-end
# TLS gate. A DNS A record for this name must point at DEPLOY_HOST first.
CADDY_DOMAIN="app.yourdomain.com"
# ACME / Let's Encrypt contact email (certificate expiry notices).
CADDY_EMAIL="ops@yourdomain.com"

# --- Optional ----------------------------------------------------------------
# SSH port when non-standard. Defaults to 22 when unset.
DEPLOY_PORT="22"

# --- NOT part of the infrastructure pipeline (business-logic / deploy.yml) ---
# ENV_FILE   - full server .env contents (app config)
# REPO_DIR   - repo path on the server (default /opt/bodapp)
# REPO_URL   - repo clone URL for brand-new servers
