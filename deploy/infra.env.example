# ---------------------------------------------------------------------------
# Bodapp — INFRASTRUCTURE pipeline secrets (.github/workflows/infra.yml)
#
# This is a CATALOG of GitHub environment secrets, not a file the server or
# docker-compose ever loads. Copy the values into:
#   GitHub → Settings → Environments → prod → Environment secrets
# Never commit real values.
#
# Transport: both pipelines join your tailnet FROM THE RUNNER with the
# ephemeral key and reach the VPS over Tailscale — the Hetzner firewall
# accepts SSH only from the tailnet (no public port 22). The business-
# logic pipeline (deploy.yml) has its own secret set — see
# deploy/github-actions-deploy.md.
# ---------------------------------------------------------------------------

# --- Required: tailnet access to the Hetzner VPS (shared with deploy.yml) ----
# Ephemeral auth key: Tailscale admin console → Settings → Keys →
# Generate ephemeral auth key (tick Ephemeral). The runner joins as a
# temporary node and logs out at the end of every run — nothing persists.
TAILSCALE_AUTHKEY="tskey-auth-..."
# Tailnet address of the VPS — MagicDNS name or 100.x IP, NOT the public IP
# (the Hetzner firewall only allows SSH from the tailnet).
DEPLOY_HOST="hetzner.tail1234.ts.net"
DEPLOY_USER="deploy"
# Private key content (full PEM text of e.g. ~/.ssh/bodapp_deploy): needed
# when the server runs normal sshd. With the Tailscale SSH server
# (`sudo tailscale set --ssh` on the VPS) authorization is by tailnet
# identity/ACL and this key is ignored — still pass it (harmless).
DEPLOY_SSH_KEY=""

# --- Required: HTTPS / Caddy (consumed only by the infrastructure pipeline) --
# Public hostname — rendered into the site address of the Caddyfile template
# (deploy/caddy/Caddyfile → /etc/caddy/Caddyfile) and used by the end-to-end
# TLS gate. A DNS A record for this name must point at the server's PUBLIC IP.
CADDY_DOMAIN="app.yourdomain.com"
# ACME / Let's Encrypt contact email (certificate expiry notices).
CADDY_EMAIL="ops@yourdomain.com"

# --- Optional ----------------------------------------------------------------
# SSH port when non-standard. Defaults to 22 when unset.
DEPLOY_PORT="22"

# --- NOT part of the infrastructure pipeline (business-logic / deploy.yml) ---
# ENV_FILE   - full server .env contents (app config)
# REPO_DIR   - repo path on the server (default /opt/bodapp)
# REPO_URL   - repo clone URL for brand-new servers
