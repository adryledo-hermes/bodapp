# ------------------------------------------------------------------
# Bodapp backup configuration — /opt/bodapp-backup/backup.env (root, 600)
# Fill the TODO values, then re-run deploy/backup/setup-backup.sh.
# These credentials are deliberately NOT GitHub secrets: they exist only
# on the server. The R2 token must be scoped to the backup bucket only.
# ------------------------------------------------------------------

# Cloudflare account id (R2 dashboard overview, right sidebar)
R2_ACCOUNT_ID=

# R2 API token: Cloudflare → R2 → Manage R2 API Tokens → Create API token
# → Custom permissions: Object Read & Write; resources: the backup bucket
# (leave empty here — setup-backup.sh refuses to run until these are set)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket the token is scoped to (create it first: R2 → Buckets → Create)
R2_BUCKET=bodapp-backups

# age PUBLIC key — encrypts every backup. The matching PRIVATE key lives
# in your password manager (and optionally on the server only as
# /root/.config/bodapp-backup/backup.key for the automated test-restore).
# Generate: age-keygen -o backup.key   (the public key is printed)
AGE_PUBKEY=

# Retention: how many daily backups to keep in R2 (free tier: 10 GB —
# adjust after checking actual sizes: rclone size bodapp-r2:<bucket>)
RETENTION_DAYS=30
# Hard cap on the SUM of all backups in R2 (decimal bytes = 10 GB = the
# free tier). Over the cap → oldest dumps deleted until the rest are
# under it; the newest dump is never removed, a lone dump never touched.
MAX_TOTAL_BYTES=10000000000
# How many encrypted copies to keep on the VPS for instant restores
KEEP_LOCAL=3

# Optional failure webhook — Discord webhook URL or Slack-compatible
# endpoint. Empty = failures are only logged (journalctl -u bodapp-backup)
# and caught by the independent staleness prober.
ALERT_WEBHOOK_URL=

# --- optional overrides (defaults shown) ---------------------------------
#APP_DB_CONTAINER=bodapp-postgres
#R2_REMOTE=bodapp-r2
#RCLONE_CONFIG=/root/.config/rclone/rclone.conf
#AGE_KEY_FILE=/root/.config/bodapp-backup/backup.key
#LOCAL_DIR=/opt/bodapp-backup/local
