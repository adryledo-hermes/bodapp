# Copy to .env and fill in real values. NEVER commit .env

# PostgreSQL connection (points at the docker-compose postgres service)
DATABASE_URL="postgresql://bodapp:bodapp@localhost:5432/bodapp?schema=public"

# Twilio SMS (sole OTP channel — no WhatsApp Business number)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Couple auth session secret (generate: openssl rand -base64 32)
SESSION_SECRET=""

# Public base URL/port used to build invitation + QR links (no domain in v1)
PUBLIC_BASE_URL="http://<server-ip>:3000"
