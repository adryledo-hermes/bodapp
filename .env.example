# Copy to .env and fill in real values. NEVER commit .env

# PostgreSQL connection (points at the docker-compose postgres service)
# Compose re-interpolates DATABASE_URL from POSTGRES_* below, so the
# user/password must match. Default password is "bodapp" for local dev;
# change POSTGRES_PASSWORD (and the matching password in DATABASE_URL) for
# anything beyond a throwaway local/dev box.
DATABASE_URL="postgresql://bodapp:bodapp@postgres:5432/bodapp?schema=public"
POSTGRES_USER="bodapp"
POSTGRES_PASSWORD="bodapp"
POSTGRES_DB="bodapp"

# Twilio credentials — shared by BOTH OTP delivery channels (WhatsApp + SMS)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Invitation OTP delivery channels. WhatsApp is PRIMARY; SMS is the FALLBACK
# and is DISABLED by default. Both are toggles ("true"/"false").
OTP_WHATSAPP_ENABLED="true"
OTP_SMS_ENABLED="false"
# Provider per channel — must match a name registered in
# src/lib/otp-providers.ts (currently only "twilio"). Swap provider here.
OTP_WHATSAPP_PROVIDER="twilio"
OTP_SMS_PROVIDER="twilio"
# WhatsApp sender. Defaults to Twilio's WhatsApp sandbox (+14155238886);
# set your own approved WhatsApp sender for production.
#TWILIO_WHATSAPP_FROM="+14155238886"

# Trusted devices: after a guest ticks "don't ask again on this device", that
# device skips the OTP for this many days (default 30, clamped 1..730).
#GUEST_TRUST_DAYS="30"

# Guest invitation access. Default is secure OTP/SMS. Set to "false" only for
# private/testing deployments: invitation links open directly without SMS.
# WARNING: anyone with the invitation URL can view it and RSVP in bypass mode.
REQUIRE_GUEST_OTP="true"

# Couple auth session secret (generate: openssl rand -base64 32)
SESSION_SECRET=""

# Login session cookie duration in HOURS (default 1). Both the cookie maxAge and
# the signed JWT expiry stay in lockstep at this value.
SESSION_MAX_AGE_HOURS="1"

# Public base URL used to build invitation + QR links. Behind Caddy this is
# the public HTTPS origin, e.g. https://app.yourdomain.com (no trailing
# slash, no port). NOTE: the scheme of this URL also decides the session
# cookie `Secure` flag — https → secure cookies (what you want in production).
PUBLIC_BASE_URL="https://app.yourdomain.com"

# Optional override for the session-cookie Secure flag ("true"/"false").
# Normally derived from PUBLIC_BASE_URL's scheme (https → true), so with
# PUBLIC_BASE_URL=https://… behind Caddy leave this unset.
#COOKIE_SECURE="true"

# NOTE: APP_PORT was removed. The app is published loopback-only as
# 127.0.0.1:3001 (docker-compose.yml) and proxied by the host's Caddy —
# the port is fixed and never exposed publicly. Delete APP_PORT from any
# old .env files; it is ignored.

# Photo storage directory. Optional — leave unset to use the app default,
# which resolves to <cwd>/storage/photos (== /app/storage/photos in the
# container, matching the compose ./storage mount). Set only if you need a
# different path, e.g. PHOTO_STORAGE_DIR="/app/storage/photos".
#PHOTO_STORAGE_DIR="/app/storage/photos"

# Outbound email provider — must match a name registered in
# src/lib/email/email-providers.ts (currently only "sendpulse"). Swap here.
EMAIL_PROVIDER="sendpulse"

# SendPulse SMTP API — outbound email (account email validation, password
# recovery). API key: sendpulse.com → Dashboard → API → API keys (SMTP).
# NEVER commit real values — placeholders only.
SENDPULSE_API_KEY=""
# Verified sender. On the SMTP Test (demo) plan this one is pre-verified:
#   SENDPULSE_API_FROM_EMAIL="devtest@sendpulseemail.com"
SENDPULSE_API_FROM_EMAIL=""
SENDPULSE_API_FROM_NAME=""
#SENDPULSE_API_BASE_URL="https://api.sendpulse.com"
