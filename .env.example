# Copy to .env and fill in real values. NEVER commit .env

# PostgreSQL connection (points at the docker-compose postgres service)
# Compose re-interpolates DATABASE_URL from POSTGRES_* below, so the
# user/password must match. Default password is "bodapp" for local dev;
# change POSTGRES_PASSWORD (and the matching password in DATABASE_URL) for
# anything beyond a throwaway local/dev box.
DATABASE_URL="postgresql://bodapp:bodapp@postgres:5432/bodapp?schema=public"
POSTGRES_USER="bodapp"
POSTGRES_PASSWORD="bodapp"
POSTGRES_DB="bodapp"

# Twilio SMS (sole OTP channel — no WhatsApp Business number)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Couple auth session secret (generate: openssl rand -base64 32)
SESSION_SECRET=""

# Public base URL/port used to build invitation + QR links (no domain in v1)
PUBLIC_BASE_URL="http://<server-ip>:3000"

# Photo storage directory. Optional — leave unset to use the app default,
# which resolves to <cwd>/storage/photos (== /app/storage/photos in the
# container, matching the compose ./storage mount). Set only if you need a
# different path, e.g. PHOTO_STORAGE_DIR="/app/storage/photos".
#PHOTO_STORAGE_DIR="/app/storage/photos"
