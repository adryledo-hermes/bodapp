// Bodapp Prisma schema — v1 core data model.
// See plan Task 1. Multi-phone invitations via Invitation.acceptedPhones
// (couple/family share one link); OTP validated against that list before sending.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RSVPStatus {
  pending
  confirmed
  declined
  maybe
}

enum UserRole {
  couple
  planner
}

enum TaskStatus {
  todo
  in_progress
  done
  blocked
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskCategory {
  legal       // juzgado, traslado expediente, cita para casarse, documentación
  vendors     // catering, fotografía, música, flores, transporte, venue
  timing      // ensayo, llegada invitados, cóctel, cena, discursos, primer baile
  gifts       // regalo especiales, lista de bodas, agradecimientos, detalles
}

model Wedding {
  id          String                @id @default(uuid())
  slug        String                @unique
  coupleNameA String
  coupleNameB String
  bankAccount String? // couple's IBAN, shown on invitations
  date        DateTime?
  locale      String                @default("es")
  createdAt   DateTime              @default(now())

  users       User[]
  guests      Guest[]
  tables      Table[]
  tasks       Task[]
  invitations Invitation[]
  templates   InvitationTemplate[]
  decorations Decoration[]
  photos      Photo[]

  @@index([slug])
}

model User {
  id           String   @id @default(uuid())
  weddingId    String
  email        String   @unique
  passwordHash String
  role         UserRole @default(couple)
  createdAt    DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id])

  @@index([weddingId])
}

model Guest {
  id                  String     @id @default(uuid())
  weddingId           String
  fullName            String
  alias               String?
  relationshipContext String? // "de qué los conocemos"
  phone               String // E.164 primary phone
  allergies           String[] @default([])
  musicPrefs          String[] @default([]) // music GENRES (multiselect)
  favoriteSong        String? // free-text favourite song
  paperInvitation     Boolean    @default(false)
  plusOneAllowed      Boolean    @default(false)
  plusOneName         String?
  rsvpStatus          RSVPStatus @default(pending)
  tableId             String?
  seatNumber          Int? // concrete seat at their table (seating map); null when unassigned/not numbered
  photoUrl            String? // app-relative /api/photos/<id>/file (tenant-scoped Photo row) or absolute URL
  notes               String?
  invitationToken     String     @unique
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  table   Table?   @relation(fields: [tableId], references: [id])
  wedding Wedding  @relation(fields: [weddingId], references: [id])
  from    GuestRelation[] @relation("guestFrom")
  to      GuestRelation[] @relation("guestTo")
  // Optional personalised invitation this guest is grouped under (manual
  // creation: pick several guests → one invitation with all their phones).
  invitation   Invitation? @relation(fields: [invitationId], references: [id])
  invitationId String?

  @@index([weddingId])
  @@index([tableId])
  @@index([invitationId])
}

// Relationships between guests (partner, sibling, "doesn't get along", etc.)
model GuestRelation {
  id             String @id @default(uuid())
  weddingId      String
  guestAId       String
  guestBId       String
  relationType   String // partner | sibling | parent | child | friend | colleague | doesnt_get_along | other

  guestA Guest @relation("guestFrom", fields: [guestAId], references: [id])
  guestB Guest @relation("guestTo", fields: [guestBId], references: [id])

  @@index([weddingId])
  @@index([guestAId])
  @@index([guestBId])
}

// An invitation link may cover several people (couple/family).
// acceptedPhones is the allowlist validated BEFORE sending an OTP.
model Invitation {
  id             String   @id @default(uuid())
  weddingId      String
  title          String   // e.g. "Familia García"
  acceptedPhones String[] @default([]) // MULTIPLE valid phones
  // Per-invitation personalization: { frame?, imageUrl?, titleA?, titleB?,
  // message?, date?, time?, venue?, dressCode? }. Null = fall back to the
  // wedding-wide template. Edited from the Invitations panel.
  content   Json?
  createdAt DateTime @default(now())

  wedding  Wedding   @relation(fields: [weddingId], references: [id])
  otpCodes OtpCode[]
  guests   Guest[] // the guests this personalised invitation is addressed to

  @@index([weddingId])
}

// One-time OTP issued for a phone against an invitation allowlist. Only the
// hashed code is stored (never plaintext); see src/lib/otp.ts.
// @see Task 9 — public invitation portal
model OtpCode {
  id           String    @id @default(uuid())
  invitationId String
  phone        String // normalized E.164 phone that requested the code
  codeHash     String // sha256 hex of the 6-digit code (never plaintext)
  attempts     Int       @default(0) // failed verify attempts
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId, phone])
  @@index([phone, expiresAt])
}

model Table {
  id        String   @id @default(uuid())
  weddingId String
  name      String
  shape     String   @default("round") // round | rectangle
  capacity  Int      @default(8)
  positionX Float    @default(0)
  positionY Float    @default(0)

  wedding     Wedding       @relation(fields: [weddingId], references: [id])
  guests      Guest[]
  decorations Decoration[]

  @@index([weddingId])
}

// Decoration & gift layer items placed on the seating canvas.
model Decoration {
  id        String   @id @default(uuid())
  weddingId String
  kind      String // centerpiece | giftTable | photoWall | danceFloor | other
  label     String?
  positionX Float    @default(0)
  positionY Float    @default(0)
  // When attached, the decoration belongs to a table on the seating canvas
  // (e.g. a centerpiece created WITH its table). Null = free-floating.
  tableId String?

  wedding Wedding @relation(fields: [weddingId], references: [id])
  table   Table?  @relation(fields: [tableId], references: [id])

  @@index([weddingId])
  @@index([tableId])
}

model Task {
  id         String       @id @default(uuid())
  weddingId  String
  title      String
  description String?
  category   TaskCategory
  priority   TaskPriority @default(medium)
  status     TaskStatus   @default(todo)
  dueDate    DateTime?
  assigneeId String?
  notes      String?
  createdAt  DateTime     @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id])

  @@index([weddingId])
  @@index([status])
}

model InvitationTemplate {
  id        String   @id @default(uuid())
  weddingId String
  version   Int      @default(1)
  content   Json // { text, images, colors, musicUrl, ... }
  publishedAt DateTime?
  createdAt DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id])

  @@index([weddingId])
}

// Couple photos (v1). Guest uploads deferred to v1.1.
model Photo {
  id        String   @id @default(uuid())
  weddingId String
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  wedding Wedding @relation(fields: [weddingId], references: [id])

  @@index([weddingId])
}
